@model HomeResponseModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="container my-5">
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 bg-gradient bg-light text-dark p-4 h-100 transition-hover">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 me-3">
                        <i class="bi bi-layers-half fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted text-uppercase small mb-1 fw-bold tracking-wider">Page Size</h6>
                        <h2 class="display-6 fw-bold mb-0 text-secondary">@Model.PageSize</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-col-md-6">
            <div class="card border-0 shadow-sm rounded-4 bg-gradient bg-light text-dark p-4 h-100 transition-hover">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 me-3">
                        <i class="bi bi-file-earmark-text fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted text-uppercase small mb-1 fw-bold tracking-wider">Page Number</h6>
                        <h2 class="display-6 fw-bold mb-0 text-secondary">@Model?.PageNo</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-white border-0 py-4 px-4 d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-1 fw-bold text-dark">Data Records Grid</h4>
                <p class="text-muted small mb-0">Overview of current page elements</p>
            </div>
            <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Refresh Grid
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-light text-uppercase fs-7 tracking-wider text-muted">
                    <tr>
                        <th class="py-3 px-4">ID</th>
                        <th class="py-3">Name / Description</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="py-3 px-4 fw-semibold text-secondary">#001</td>
                        <td class="py-3">
                            <div class="d-flex flex-column">
                                <span class="fw-bold text-dark">Sample Item Name</span>
                                <span class="text-muted small">Detailed sub-text goes here</span>
                            </div>
                        </td>
                        <td class="py-3">
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Active</span>
                        </td>
                        <td class="py-3 text-end px-4">
                            <button class="btn btn-light btn-sm rounded-circle me-1" title="Edit"><i class="bi bi-pencil-semibold"></i></button>
                            <button class="btn btn-light btn-sm rounded-circle text-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 bg-dark text-white p-4 rounded-4 shadow d-flex flex-md-row justify-content-between align-items-center">
        <div class="mb-3 mb-md-0">
            <h5 class="fw-bold mb-1">Want to learn more about ASP.NET Core?</h5>
            <p class="text-white-50 small mb-0">Explore professional tools and frameworks to level up your web app.</p>
        </div>
        <a href="https://learn.microsoft.com/aspnet/core" target="_blank" class="btn btn-light btn-lg rounded-pill px-4 fs-6 shadow-sm fw-semibold">
            Explore Documentation <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</div>

<style>
    .tracking-wider { letter-spacing: 0.05em; }
    .fs-7 { font-size: 0.8rem; }
    .transition-hover { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .transition-hover:hover { transform: translateY(-4px); box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1)!important; }
    .custom-table tbody tr { transition: background-color 0.2s ease; }
    .custom-table tbody tr:hover { background-color: rgba(248, 249, 250, 0.8); }
</style>
