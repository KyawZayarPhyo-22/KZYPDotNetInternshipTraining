<form action="/student/save"  method="post">
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg border-0 rounded-3">

                <div class="card-header bg-primary text-white p-4">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-person-plus-fill me-2"></i> Create Student
                    </h4>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="No" class="form-label fw-semibold">Student No</label>
                            <input for="No" class="form-control" name="No" placeholder="e.g., STU-001" required />
                        </div>

                        <div class="mb-3">
                            <label for="Name" class="form-label fw-semibold">Student Name</label>
                            <input for="Name" class="form-control" name="Name" placeholder="e.g., Aung Aung" required />
                        </div>

                        <div class="mb-3">
                            <label for="FatherName" class="form-label fw-semibold">Father Name</label>
                            <input for="FatherName" class="form-control" name="FatherName" placeholder="e.g., U Hla" required />
                        </div>

                        <div class="mb-3">
                            <label for="DateOfBirth" class="form-label fw-semibold">Date of Birth</label>
                            <input for="DateOfBirth" type="date" name="DateOfBirth" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label for="Address" class="form-label fw-semibold">Address</label>
                            <textarea for="Address" class="form-control" name="Address" placeholder="Enter address here..." style="height: 100px" required></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm">Save Student</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
</form>