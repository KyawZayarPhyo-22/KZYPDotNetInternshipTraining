@model StudentResponseModel;
@{
	int count = (Model.PageNo -1)*Model.PageSize;
}


<a href="/student/create" class="btn btn-primary mb-3">Create New Student</a>
 


<table class="table table-responsive ">
    <thead>
        <tr>
			<th>No</th>
			<th>Name</th>
			<th>FatherName</th>
			<th>Address</th>
			<th>DateofBirth</th>

        </tr>
    </thead>
    <tbody>
		@foreach (var student in Model.Data)
		{
			<tr>
				<td>@(++count)</td>
				<td>@student.Name</td>
				<td>@student.FatherName</td>
				<td>@student.Address</td>
				<td>@student.DateOfBirth</td>


			</tr>
		}
    </tbody>
</table>
<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">


        @for (int i = 1; i <= Model.PageCount; i++)
        {
			if (Model.PageNo == i)
			{
				<li class="page-item active">
					<a class="page-link" href="/Student/Index?PageNo=@(i)&PageSize=@(Model.PageSize)">@i</a>
				</li>
			}
			else
			{
				<li class="page-item ">
					<a class="page-link" href="/Student/Index?PageNo=@(i)&PageSize=@(Model.PageSize)">@i </a>
				</li>
			}

        }

       

    </ul>
</nav>